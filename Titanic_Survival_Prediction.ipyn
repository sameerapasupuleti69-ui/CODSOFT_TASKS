      },
      "source": [
        "# === Python Lists Practice ===\n",
        "\n",
        "# Exercise 1: Create a list of 5 favorite fruits and print the 1st, 3rd, and last items.\n",
        "fruits = [\"Apple\", \"Banana\", \"Cherry\", \"Mango\", \"Orange\"]\n",
        "\n",
        "print(\"--- Exercise 1 Results ---\")\n",
        "print(\"First fruit:\", fruits[0])\n",
        "print(\"Third fruit:\", fruits[2])\n",
        "print(\"Last fruit:\", fruits[-1])\n",
        "print()\n",
        "\n",
        "# Exercise 2: Start with a list of colors, append 'Yellow', remove 'Blue', and print the final list.\n",
        "colors = [\"Red\", \"Blue\", \"Green\", \"Purple\"]\n",
        "colors.append(\"Yellow\")\n",
        "colors.remove(\"Blue\")\n",
        "\n",
        "print(\"--- Exercise 2 Results ---\")\n",
        "print(\"Updated list of colors:\", colors)\n",
        "print()\n",
        "\n",
        "# Exercise 3: Create a list of numbers, find the maximum and minimum values.\n",
        "numbers = [45, 82, 19, 55, 97, 23, 60]\n",
        "max_val = max(numbers)\n",
        "min_val = min(numbers)\n",
        "\n",
        "print(\"--- Exercise 3 Results ---\")\n",
        "print(\"List of numbers:\", numbers)\n",
        "print(\"Maximum value:\", max_val)\n",
        "print(\"Minimum value:\", min_val)"
      ],
      "execution_count": 9,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "--- Exercise 1 Results ---\n",
            "First fruit: Apple\n",
            "Third fruit: Cherry\n",
            "Last fruit: Orange\n",
            "\n",
            "--- Exercise 2 Results ---\n",
            "Updated list of colors: ['Red', 'Green', 'Purple', 'Yellow']\n",
            "\n",
            "--- Exercise 3 Results ---\n",
            "List of numbers: [45, 82, 19, 55, 97, 23, 60]\n",
            "Maximum value: 97\n",
            "Minimum value: 19\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# === Python Dictionaries Practice ===\n",
        "\n",
        "# Exercise 1: Create a movie dictionary and print its title and director.\n",
        "movie = {\n",
        "    \"title\": \"Inception\",\n",
        "    \"director\": \"Christopher Nolan\",\n",
        "    \"year\": 2010\n",
        "}\n",
        "\n",
        "print(\"--- Exercise 1 Results ---\")\n",
        "print(\"Movie Title:\", movie[\"title\"])\n",
        "print(\"Director:\", movie[\"director\"])\n",
        "print()\n",
        "\n",
        "# Exercise 2: Update the release year and add a new 'rating' key.\n",
        "movie[\"year\"] = 2011\n",
        "movie[\"rating\"] = 8.8\n",
        "\n",
        "print(\"--- Exercise 2 Results ---\")\n",
        "print(\"Updated Movie Dictionary:\", movie)\n",
        "print()\n",
        "\n",
        "# Exercise 3: Loop through the dictionary and print each key-value pair.\n",
        "print(\"--- Exercise 3 Results ---\")\n",
        "for key, value in movie.items():\n",
        "    print(f\"{key.capitalize()}: {value}\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "631xJGQEVZuR",
        "outputId": "c0136192-2b32-4268-8c7d-820827bac5c0"
      },
      "execution_count": 10,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "--- Exercise 1 Results ---\n",
            "Movie Title: Inception\n",
            "Director: Christopher Nolan\n",
            "\n",
            "--- Exercise 2 Results ---\n",
            "Updated Movie Dictionary: {'title': 'Inception', 'director': 'Christopher Nolan', 'year': 2011, 'rating': 8.8}\n",
            "\n",
            "--- Exercise 3 Results ---\n",
            "Title: Inception\n",
            "Director: Christopher Nolan\n",
            "Year: 2011\n",
            "Rating: 8.8\n"
          ]
        }
      ]
