        "# === Intro to Data Science: Real-World Application ===\n",
        "# Let's use the 'pandas' library to explore a real dataset: California Housing\n",
        "\n",
        "import pandas as pd\n",
        "\n",
        "# 1. Load the dataset\n",
        "file_path = \"sample_data/california_housing_test.csv\"\n",
        "df = pd.read_csv(file_path)\n",
        "\n",
        "print(\"--- 1. First 5 Rows of the Dataset ---\")\n",
        "display(df.head())\n",
        "\n",
        "print(\"\\n--- 2. Dataset Information (Columns & Types) ---\")\n",
        "print(df.info())\n",
        "\n",
        "print(\"\\n--- 3. Basic Statistical Summary ---\")\n",
        "# This gives us the mean, min, max, and standard deviation of our data\n",
        "display(df.describe())\n",
        "\n",
        "print(\"\\n--- 4. Real-World Question: What is the average house value? ---\")\n",
        "avg_value = df[\"median_house_value\"].mean()\n",
        "print(f\"The average median house value in this California dataset is: ${avg_value:,.2f}\")"
      ],
