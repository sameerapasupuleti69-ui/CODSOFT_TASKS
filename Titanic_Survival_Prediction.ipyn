    {
      "cell_type": "code",
      "source": [
        "# === Python File Handling Practice ===\n",
        "\n",
        "# Exercise 1: Write text to a new file named 'practice.txt'\n",
        "with open(\"practice.txt\", \"w\") as file:\n",
        "    file.write(\"Hello! This is a file handling practice.\\n\")\n",
        "    file.write(\"Python makes it easy to read and write files.\\n\")\n",
        "\n",
        "print(\"--- Exercise 1 Results ---\")\n",
        "print(\"File 'practice.txt' created and written successfully!\")\n",
        "print()\n",
        "\n",
        "# Exercise 2: Read the content from 'practice.txt' and display it\n",
        "print(\"--- Exercise 2 Results (Reading file) ---\")\n",
        "with open(\"practice.txt\", \"r\") as file:\n",
        "    content = file.read()\n",
        "    print(content)\n",
        "\n",
        "# Exercise 3: Append a new line to 'practice.txt' and read it again\n",
        "with open(\"practice.txt\", \"a\") as file:\n",
        "    file.write(\"This line was appended successfully!\\n\")\n",
        "\n",
        "print(\"--- Exercise 3 Results (After Appending) ---\")\n",
        "with open(\"practice.txt\", \"r\") as file:\n",
        "    updated_content = file.read()\n",
        "    print(updated_content)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "vLnIrKuBVomL",
        "outputId": "2b489b96-eb5b-4982-98f4-dc38e981b0ac"
      },
      "execution_count": 11,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "--- Exercise 1 Results ---\n",
